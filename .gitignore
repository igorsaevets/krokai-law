# A matter's own files never belong in this repository. Listed first because that is the mistake
# with consequences: this tool is used on privileged material.
casefile.json
law/
case/
guides/
research/
reports/
reviews/
answers/
*.text.md

# Browser-automation debris. 🔴 Named explicitly: in a different project a folder like this held
# 497 KB of live session URLs with a token in the query string, and it was one `git add -A` away
# from being published.
.playwright-mcp/

# A maintainer's local assistant layer: personal instructions, session transcripts, MCP configs
# that can carry tokens. Kept out by .git/info/exclude on the machine where it lives - but that
# file is not cloned, and one fresh clone plus `git add -A` would publish it. So it is named here.
/CLAUDE.local.md
/.claude/
/.mcp.json
/private/

# Local state written by the hooks
.krokai/
*.backup-*

# Pre-edit backup snapshots on the maintainer's machine. The Cyrillic name predates the
# Latin-only naming advice in the templates and stays: renaming it would strand old snapshots.
архив/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Anything credential-shaped, belt and braces
.env
.env.*
*.pem
*.key

# Keys. The recommended place is OUTSIDE this folder (`krokai keys --setup`), but if
# someone points KROKAI_KEY_DIR here, this stops the accident becoming permanent.
.env
.env.*
!.env.example
keys.env
*.key
